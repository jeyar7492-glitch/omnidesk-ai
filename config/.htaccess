# OmniDesk AI — config/.htaccess
# Deny all direct HTTP access to configuration files.
# Configuration files must never be served to browsers.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2 fallback
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
