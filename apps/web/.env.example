# ==============================================================================
# OmniDesk AI — Frontend (Vite) Environment Configuration
# ==============================================================================

# Backend API endpoint (e.g. Render hosted API URL or localhost for dev)
# Note: can be provided with or without trailing slash or /api/v1
VITE_API_URL=https://omnidesk-ai-mm3f.onrender.com

# Optional WebSocket URL (if omitted, automatically derived from VITE_API_URL: wss://.../ws)
VITE_WS_URL=wss://omnidesk-ai-mm3f.onrender.com/ws

# Prototype mode is enabled by default for the public demo. Set false to use API-backed login/workspace.
VITE_DEMO_MODE=true
