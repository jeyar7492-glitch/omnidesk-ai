  projectsCategory  Boolean              @default(true)
  crmCategory       Boolean              @default(true)
  financeCategory   Boolean              @default(true)
  documentsCategory Boolean              @default(true)
  systemCategory    Boolean              @default(true)
  communicationCategory Boolean          @default(true)
  minPriority       NotificationPriority @default(LOW)
