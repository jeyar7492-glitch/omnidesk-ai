datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x", "linux-musl-openssl-3.0.x", "rhel-openssl-3.0.x"]
}


enum RoleType {
  OWNER
  ADMIN
  MANAGER
  MEMBER
  VIEWER
  FINANCE
}

enum DealStage {
  QUALIFICATION
  CONTACTED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum PriorityLevel {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_MENTIONED
  TASK_DUE_SOON
  TASK_OVERDUE
  TASK_COMMENTED
  PROJECT_UPDATED
  PROJECT_MEMBER_ADDED
  MILESTONE_DUE
  LEAD_ASSIGNED
  LEAD_STATUS_CHANGED
  DEAL_STAGE_CHANGED
  DEAL_WON
  DEAL_LOST
  INVOICE_CREATED
  INVOICE_SENT
  INVOICE_OVERDUE
  PAYMENT_RECEIVED
  EXPENSE_SUBMITTED
  EXPENSE_APPROVED
  EXPENSE_REJECTED
  DOCUMENT_UPLOADED
  DOCUMENT_PROCESSED
  DOCUMENT_FAILED
  KNOWLEDGE_BASE_UPDATED
  SYSTEM_ALERT
  SECURITY_ALERT
  COMMUNICATION_MESSAGE
  COMMUNICATION_MENTION
  COMMUNICATION_REPLY
}

enum ConversationType {
  DIRECT
  GROUP
}

enum ConversationMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum MessageType {
  TEXT
  SYSTEM
  ATTACHMENT
}

model User {
  id                      String                   @id @default(auto()) @map("_id") @db.ObjectId
  email                   String                   @unique
  passwordHash            String
  firstName               String
  lastName                String
  avatarUrl               String?
  isActive                Boolean                  @default(true)
  isVerified              Boolean                  @default(false)
  lastLoginAt             DateTime?
  memberships             WorkspaceMember[]
  createdTasks            Task[]                   @relation("TaskReporter")
  assignedTasks           Task[]                   @relation("TaskAssignee")
  managedProjects         Project[]                @relation("ProjectManager")
  projectMemberships      ProjectMember[]          @relation("ProjectMemberUser")
  taskComments            TaskComment[]
  chatMessages            ChatMessage[]
  auditEvents             AuditEvent[]
  aiConversations         AIConversation[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  createdConversations    Conversation[]           @relation("ConversationCreatedBy")
  conversationMemberships ConversationMember[]     @relation("UserConversationMembers")
  sentMessages            Message[]                @relation("UserMessages")
  uploadedAttachments     MessageAttachment[]      @relation("UserUploadedAttachments")
  messageReactions        MessageReaction[]        @relation("UserMessageReactions")
  messageMentions         MessageMention[]         @relation("UserMessageMentions")
  refreshTokens           RefreshToken[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
}

model RefreshToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  token     String   @unique
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Organization {
  id         String      @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  slug       String      @unique
  plan       String      @default("enterprise")
  workspaces Workspace[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Workspace {
  id              String            @id @default(auto()) @map("_id") @db.ObjectId
  organizationId  String            @db.ObjectId
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  slug            String
  description     String?
  members         WorkspaceMember[]
  customers       Customer[]
  contacts        Contact[]
  leads           Lead[]
  deals           Deal[]
  activities      CRMActivity[]
  projects        Project[]
  boards          Board[]
  tasks           Task[]
  invoices        Invoice[]
  payments        Payment[]
  expenses        Expense[]
  expenseCategories ExpenseCategory[]
  vendors         Vendor[]
  documents       Document[]
  knowledgeBases  KnowledgeBase[]
  channels        Channel[]
  meetings        Meeting[]
  automations     AutomationRule[]
  auditEvents             AuditEvent[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  conversations           Conversation[]
  conversationMembers     ConversationMember[]
  messages                Message[]
  messageAttachments      MessageAttachment[]
  messageReactions        MessageReaction[]
  messageMentions         MessageMention[]
  aiConversations         AIConversation[]
  aiApprovals             AIApprovalRequest[]
  aiExecutions    AIExecution[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([organizationId, slug])
}

model WorkspaceMember {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String     @db.ObjectId
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String     @db.ObjectId
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        RoleType   @default(MEMBER)
  permissions String[]   @default([])
  joinedAt    DateTime   @default(now())

  @@unique([workspaceId, userId])
}

model Customer {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId    String        @db.ObjectId
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  companyName    String
  contactPerson  String?
  email          String?
  phone          String?
  website        String?
  industry       String?
  address        String?
  city           String?
  state          String?
  country        String?
  status         String        @default("active")
  notes          String?
  isArchived     Boolean       @default(false)
  assignedUserId String?       @db.ObjectId
  contacts       Contact[]
  leads          Lead[]
  deals          Deal[]
  projects       Project[]
  invoices       Invoice[]
  payments       Payment[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([workspaceId, companyName])
  @@index([workspaceId, isArchived])
  @@index([workspaceId, status])
}

model Contact {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String        @db.ObjectId
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customerId  String?       @db.ObjectId
  customer    Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  firstName   String
  lastName    String
  email       String?
  phone       String?
  jobTitle    String?
  department  String?
  isPrimary   Boolean       @default(false)
  notes       String?
  isArchived  Boolean       @default(false)
  deals       Deal[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([workspaceId, email])
  @@index([workspaceId, customerId])
  @@index([workspaceId, isArchived])
}

model Lead {
  id                  String        @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId         String        @db.ObjectId
  workspace           Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customerId          String?       @db.ObjectId
  customer            Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  title               String
  source              String?
  status              String        @default("new")
  stage               DealStage     @default(QUALIFICATION)
  dealValue           Float         @default(0.0)
  probability         Int           @default(20)
  expectedClose       DateTime?
  priority            PriorityLevel @default(MEDIUM)
  assignedUserId      String?       @db.ObjectId
  nextAction          String?
  nextActionDate      DateTime?
  notes               String?
  lostReason          String?
  isConverted         Boolean       @default(false)
  convertedAt         DateTime?
  convertedCustomerId String?       @db.ObjectId
  convertedContactId  String?       @db.ObjectId
  convertedDealId     String?       @db.ObjectId
  isArchived          Boolean       @default(false)
  deals               Deal[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([workspaceId, stage])
  @@index([workspaceId, isArchived])
  @@index([workspaceId, status])
}

model Deal {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId    String        @db.ObjectId
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customerId     String?       @db.ObjectId
  customer       Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  contactId      String?       @db.ObjectId
  contact        Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  leadId         String?       @db.ObjectId
  lead           Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  title          String
  currency       String        @default("USD")
  stage          DealStage     @default(QUALIFICATION)
  dealValue      Float         @default(0.0)
  probability    Int           @default(20)
  expectedClose  DateTime?
  closedAt       DateTime?
  priority       PriorityLevel @default(MEDIUM)
  assignedUserId String?       @db.ObjectId
  lostReason     String?
  notes          String?
  isArchived     Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([workspaceId, stage])
  @@index([workspaceId, expectedClose])
  @@index([workspaceId, assignedUserId])
  @@index([workspaceId, isArchived])
}

model CRMActivity {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String    @db.ObjectId
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entityType  String    // "lead" | "deal" | "customer" | "contact"
  entityId    String    @db.ObjectId
  type        String    @default("note") // "note" | "call" | "meeting" | "email" | "follow_up"
  title       String
  content     String?
  dueDate     DateTime?
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  userId      String?   @db.ObjectId
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId, entityType, entityId])
  @@index([workspaceId, dueDate])
  @@index([workspaceId, isCompleted])
  @@index([workspaceId, createdAt])
}

model Project {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String          @db.ObjectId
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customerId  String?         @db.ObjectId
  customer    Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  name        String
  key         String?
  description String?
  status      ProjectStatus   @default(PLANNING)
  priority    PriorityLevel   @default(MEDIUM)
  budget      Float           @default(0.0)
  spent       Float           @default(0.0)
  startDate   DateTime?
  deadline    DateTime?
  completedAt DateTime?
  color       String?
  ownerId     String?         @db.ObjectId
  managerId   String?         @db.ObjectId
  manager     User?           @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)
  members     ProjectMember[]
  milestones  Milestone[]
  boards      Board[]
  tasks       Task[]
  invoices    Invoice[]
  expenses    Expense[]
  meetings    Meeting[]
  health      String          @default("healthy")
  isArchived  Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([workspaceId, status])
  @@index([workspaceId, isArchived])
  @@index([workspaceId, managerId])
  @@index([workspaceId, key])
  @@index([workspaceId, priority])
}

model ProjectMember {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String    @db.ObjectId
  projectId   String    @db.ObjectId
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String    @db.ObjectId
  user        User      @relation("ProjectMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  role        String    @default("MEMBER") // "LEAD" | "MEMBER" | "VIEWER"
  joinedAt    DateTime  @default(now())

  @@unique([projectId, userId])
  @@index([workspaceId, projectId])
  @@index([workspaceId, userId])
}

model Milestone {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId    String    @db.ObjectId
  projectId      String    @db.ObjectId
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  dueDate        DateTime?
  status         String    @default("pending")
  assignedUserId String?   @db.ObjectId
  progress       Int       @default(0)
  completedAt    DateTime?
  tasks          Task[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([workspaceId, projectId])
  @@index([workspaceId, status])
}

model Board {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String        @db.ObjectId
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId   String?       @db.ObjectId
  project     Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  name        String
  description String?
  isDefault   Boolean       @default(false)
  columns     BoardColumn[]
  tasks       Task[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model BoardColumn {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String    @db.ObjectId
  boardId     String    @db.ObjectId
  board       Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name        String
  key         String
  position    Int       @default(0)
  wipLimit    Int?
  color       String?
  tasks       Task[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([boardId, key])
}

model Task {
  id               String          @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId      String          @db.ObjectId
  workspace        Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId        String?         @db.ObjectId
  project          Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  milestoneId      String?         @db.ObjectId
  milestone        Milestone?      @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  boardId          String?         @db.ObjectId
  board            Board?          @relation(fields: [boardId], references: [id], onDelete: SetNull)
  columnId         String?         @db.ObjectId
  column           BoardColumn?    @relation(fields: [columnId], references: [id], onDelete: SetNull)
  parentTaskId     String?         @db.ObjectId
  title            String
  description      String?
  status           String          @default("todo")
  priority         PriorityLevel   @default(MEDIUM)
  position         Int             @default(0)
  assigneeId       String?         @db.ObjectId
  assignee         User?           @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporterId       String?         @db.ObjectId
  reporter         User?           @relation("TaskReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  startDate        DateTime?
  dueDate          DateTime?
  estimatedHours   Float?
  actualHours      Float?
  labels           String[]        @default([])
  dependencies     String[]        @default([])
  taskDependencies TaskDependency[] @relation("TaskSource")
  dependents       TaskDependency[] @relation("TaskTarget")
  isBlocked        Boolean         @default(false)
  blockedReason    String?
  isArchived       Boolean         @default(false)
  completedAt      DateTime?
  checklists       TaskChecklist[]
  comments         TaskComment[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([workspaceId, status])
  @@index([columnId, position])
  @@index([workspaceId, projectId])
  @@index([workspaceId, assigneeId])
  @@index([workspaceId, dueDate])
  @@index([workspaceId, isArchived])
  @@index([workspaceId, priority])
}

model TaskDependency {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId     String    @db.ObjectId
  taskId          String    @db.ObjectId
  task            Task      @relation("TaskSource", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTaskId String    @db.ObjectId
  dependsOnTask   Task      @relation("TaskTarget", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)
  type            String    @default("BLOCKS") // "BLOCKS" | "RELATION"
  createdAt       DateTime  @default(now())

  @@unique([taskId, dependsOnTaskId])
  @@index([workspaceId, taskId])
  @@index([workspaceId, dependsOnTaskId])
}

model TaskChecklist {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String?  @db.ObjectId
  taskId      String   @db.ObjectId
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title       String
  isCompleted Boolean  @default(false)
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([taskId, position])
}

model TaskComment {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String?  @db.ObjectId
  taskId      String   @db.ObjectId
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId      String?  @db.ObjectId
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([taskId, createdAt])
}

model Invoice {
  id             String            @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId    String            @db.ObjectId
  workspace      Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customerId     String            @db.ObjectId
  customer       Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  projectId      String?           @db.ObjectId
  project        Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  invoiceNumber  String
  status         String            @default("draft") // "draft" | "sent" | "partially_paid" | "paid" | "overdue" | "cancelled"
  currency       String            @default("USD")
  issueDate      DateTime          @default(now())
  dueDate        DateTime
  subtotal       Float             @default(0.0)
  discountAmount Float             @default(0.0)
  taxRate        Float             @default(0.0)
  taxAmount      Float             @default(0.0)
  totalAmount    Float             @default(0.0)
  amountPaid     Float             @default(0.0)
  amountDue      Float             @default(0.0)
  notes          String?
  terms          String?           @default("Net 30 Days")
  isArchived     Boolean           @default(false)
  createdBy      String?
  createdById    String?           @db.ObjectId
  items          InvoiceLineItem[]
  payments       Payment[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([workspaceId, invoiceNumber])
  @@index([workspaceId, customerId])
  @@index([workspaceId, projectId])
  @@index([workspaceId, status])
  @@index([workspaceId, dueDate])
  @@index([workspaceId, isArchived])
  @@index([workspaceId, createdAt])
}

model InvoiceLineItem {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  invoiceId      String   @db.ObjectId
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description    String
  quantity       Float    @default(1.0)
  unitPrice      Float    @default(0.0)
  taxRate        Float    @default(0.0)
  discountAmount Float    @default(0.0)
  lineTotal      Float    @default(0.0)
  position       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([invoiceId, position])
}

model Payment {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId   String    @db.ObjectId
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoiceId     String    @db.ObjectId
  invoice       Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  customerId    String?   @db.ObjectId
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  amount        Float
  currency      String    @default("USD")
  paymentDate   DateTime  @default(now())
  paymentMethod String    @default("bank_transfer")
  reference     String?
  notes         String?
  createdBy     String?
  createdById   String?   @db.ObjectId
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([workspaceId, invoiceId])
  @@index([workspaceId, customerId])
  @@index([workspaceId, paymentDate])
}

model ExpenseCategory {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String    @db.ObjectId
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isActive    Boolean   @default(true)
  expenses    Expense[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId, isActive])
}

model Expense {
  id               String           @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId      String           @db.ObjectId
  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId        String?          @db.ObjectId
  project          Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  categoryId       String?          @db.ObjectId
  category         ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryName     String?          @default("General")
  vendorId         String?          @db.ObjectId
  vendorRef        Vendor?          @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  vendor           String
  description      String
  amount           Float
  currency         String           @default("USD")
  expenseDate      DateTime         @default(now())
  paymentMethod    String           @default("credit_card")
  approvalStatus   String           @default("pending") // "pending" | "approved" | "rejected"
  receiptReference String?
  notes            String?
  createdBy        String?
  createdById      String?          @db.ObjectId
  approvedBy       String?
  approvedById     String?          @db.ObjectId
  approvedAt       DateTime?
  isArchived       Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([workspaceId, projectId])
  @@index([workspaceId, categoryId])
  @@index([workspaceId, expenseDate])
  @@index([workspaceId, approvalStatus])
  @@index([workspaceId, isArchived])
  @@index([workspaceId, createdAt])
}

model Vendor {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId  String    @db.ObjectId
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name         String
  contactEmail String?
  phone        String?
  category     String?
  paymentTerms String?
  status       String    @default("active")
  expenses     Expense[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([workspaceId, name])
}

model Document {
  id               String                  @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId      String                  @db.ObjectId
  workspace        Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name             String
  title            String?                 // backward compatibility with old skeleton
  originalFileName String
  mimeType         String                  @default("application/pdf")
  extension        String
  sizeBytes        Int                     @default(0)
  filePath         String?                 // backward compatibility
  fileSize         Int?                    @default(0) // backward compatibility
  storageProvider  String                  @default("local")
  storageKey       String
  checksum         String
  status           String                  @default("ready") // uploading, processing, ready, failed, archived
  description      String?
  category         String?                 @default("General")
  folderPath       String?                 @default("/")
  ownerId          String?                 @db.ObjectId
  uploadedBy       String?                 @db.ObjectId
  currentVersionId String?                 @db.ObjectId
  isArchived       Boolean                 @default(false)
  processingError  String?
  extractedText    String?
  metadata         Json?
  versions         DocumentVersion[]
  chunks           DocumentChunk[]
  knowledgeBases   KnowledgeBaseDocument[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([workspaceId, name])
  @@index([workspaceId, status])
  @@index([workspaceId, isArchived])
  @@index([workspaceId, ownerId])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, checksum])
  @@index([workspaceId, category])
}

model DocumentVersion {
  id               String          @id @default(auto()) @map("_id") @db.ObjectId
  documentId       String          @db.ObjectId
  document         Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionNumber    Int             @default(1)
  storageKey       String
  checksum         String
  sizeBytes        Int             @default(0)
  extractedText    String?
  createdBy        String?         @db.ObjectId
  metadata         Json?
  chunks           DocumentChunk[]
  createdAt        DateTime        @default(now())

  @@unique([documentId, versionNumber])
  @@index([documentId, createdAt])
}

model DocumentChunk {
  id                String           @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId       String           @db.ObjectId
  documentId        String           @db.ObjectId
  document          Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentVersionId String?          @db.ObjectId
  documentVersion   DocumentVersion? @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  chunkIndex        Int
  content           String
  tokenCount        Int              @default(0)
  characterCount    Int              @default(0)
  contentHash       String?
  embedding         Float[]          @default([])
  metadata          Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([workspaceId, documentId])
  @@index([workspaceId, documentVersionId])
  @@index([documentId, chunkIndex])
  @@index([workspaceId, contentHash])
}

model KnowledgeBase {
