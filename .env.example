# OmniDesk AI Environment Configuration Template
# Copy this file to .env or configure in your web server / system environment.

# App Environment
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost
APP_KEY=base64:OmniDeskAIProductionSecretKeyPlaceholder2026=

# Database Configuration (MySQL 8.0+)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=omnidesk_ai
DB_USERNAME=root
DB_PASSWORD=

# Python Agentic AI Gateway
PYTHON_AI_HOST=127.0.0.1
PYTHON_AI_PORT=8008
PYTHON_AI_SECRET=OmniDeskAIServiceSecretSalt2026

# Session Security
SESSION_LIFETIME=7200
SESSION_SECURE_COOKIE=false
