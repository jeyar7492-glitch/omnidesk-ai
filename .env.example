# ==============================================================================
# OmniDesk AI — Environment Configuration
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Database Configuration (MongoDB via Prisma)
# Example local replica set or Atlas connection string:
DATABASE_URL="mongodb://localhost:27017/omnidesk_ai?authSource=admin"

# Authentication & Security Secrets
JWT_ACCESS_SECRET="CHANGE_ME_IN_PRODUCTION_JWT_ACCESS_SECRET_32_CHARS_MIN"
JWT_REFRESH_SECRET="CHANGE_ME_IN_PRODUCTION_JWT_REFRESH_SECRET_32_CHARS_MIN"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Frontend Configuration
VITE_API_BASE_URL="http://localhost:4000"
VITE_WS_URL="ws://localhost:4000"
