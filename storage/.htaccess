# OmniDesk AI — storage/.htaccess
# Deny direct HTTP access to storage (logs + uploads).
# PHP execution inside uploads is explicitly forbidden.

# ── Deny everything by default ───────────────────────────────────────────────
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

# ── Prevent PHP execution in uploads directory ────────────────────────────────
# Even if access were somehow granted, PHP files cannot be executed here.
<FilesMatch "\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# ── Disable directory indexing ────────────────────────────────────────────────
Options -Indexes
