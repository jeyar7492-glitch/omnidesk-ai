# OmniDesk AI — public/.htaccess
# Apache mod_rewrite configuration for the front controller pattern.
# All requests (except real files/directories) route through public/index.php.

# ── Enable rewrite engine ─────────────────────────────────────────────────────
Options -MultiViews -Indexes
RewriteEngine On

# ── Set the rewrite base (adjust if app is in a subdirectory) ────────────────
# RewriteBase /omnidesk-ai/

# ── Block access to dot files (e.g. .htaccess, .env) ─────────────────────────
RewriteRule ^\.             - [F,L]
RewriteCond %{REQUEST_URI}  /\.
RewriteRule ^               - [F,L]

# ── Allow direct access to real files and directories ────────────────────────
# (Static assets: CSS, JS, images, fonts)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ── Route all other requests through the front controller ────────────────────
RewriteRule ^ index.php [L]

# ── Security: prevent execution of PHP in assets directory ───────────────────
<IfModule mod_rewrite.c>
    RewriteCond %{REQUEST_URI} ^/assets/
    RewriteRule \.php$ - [F,L]
</IfModule>

# ── Security: block common attack patterns in query strings ──────────────────
RewriteCond %{QUERY_STRING} (<|%3C).*script.*(>|%3E)        [NC,OR]
RewriteCond %{QUERY_STRING} GLOBALS(=|\[|\%[0-9A-Z]{0,2})   [OR]
RewriteCond %{QUERY_STRING} _REQUEST(=|\[|\%[0-9A-Z]{0,2})
RewriteRule ^ - [F,L]

# ── Security headers (supplemental — primary headers set in PHP) ──────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# ── Disable server signature ──────────────────────────────────────────────────
ServerSignature Off
