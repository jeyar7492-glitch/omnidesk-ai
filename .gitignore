# OmniDesk AI — Production .gitignore

# Environment Configurations & Secrets
.env
.env.*
!.env.example

# Temporary Storage & Backups
storage/logs/*
!storage/logs/.gitkeep
storage/backups/*
!storage/backups/.gitkeep
storage/cache/*
!storage/cache/.gitkeep
storage/app/*
!storage/app/.gitkeep

# Python Compilation & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# IDE & Editor Files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Test Coverage & Temporary Artifacts
.coverage
.pytest_cache/
htmlcov/
*.log
